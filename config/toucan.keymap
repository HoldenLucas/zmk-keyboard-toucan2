#include <behaviors.dtsi>
#include <zmk-helpers/helper.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/* urob-style behaviors (ported incrementally from urob/zmk-config) */

#define QUICK_TAP_MS 175

&sk {
    release-after-ms = <900>;
    quick-release;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
};

/* Matrix positions: row-major (0-11 top, 12-23 home, 24-35 bottom; 36-41 thumbs). */
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29  // Left half.
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35  // Right half.
#define THUMBS 36 37 38 39 40 41

/* Home-row mods: tap = letter, hold = mod. Triggered only by the opposite hand. */
#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS)                                 \
    ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced";         \
                 tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>;      \
                 require-prior-idle-ms = <150>; hold-trigger-on-release;      \
                 hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS) // Left-hand HRMs.
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS) // Right-hand HRMs.

/* Combo hold-taps (urob hack): tap = symbol, hold = mod for chording. */
MAKE_HRM(hm_combo_lpar, &kp, &lpar_lt, KEYS_L THUMBS)
MAKE_HRM(hm_combo_rpar, &kp, &rpar_gt, KEYS_L THUMBS)

/* Tap: comma | Shift+tap: semicolon | Ctrl+Shift+tap: <. */
#define SIMPLE_MORPH(NAME, MOD, BINDING1, BINDING2)                            \
    ZMK_MOD_MORPH(NAME, mods = <(MOD_L##MOD | MOD_R##MOD)>;                    \
                  bindings = <BINDING1>, <BINDING2>;)

SIMPLE_MORPH(comma_morph, SFT, &kp COMMA, &comma_inner_morph)
SIMPLE_MORPH(comma_inner_morph, CTL, &kp SEMICOLON, &kp LESS_THAN)

/* Tap: dot | Shift+tap: colon | Ctrl+Shift+tap: >. */
SIMPLE_MORPH(dot_morph, SFT, &kp DOT, &dot_inner_morph)
SIMPLE_MORPH(dot_inner_morph, CTL, &kp COLON, &kp GREATER_THAN)

/* Tap: qmark | Shift+tap: excl. */
SIMPLE_MORPH(qexcl, SFT, &kp QMARK, &kp EXCL)

/* Tap: left/right paren | Shift+tap: </>. */
SIMPLE_MORPH(lpar_lt, SFT, &kp LPAR, &kp LT)
SIMPLE_MORPH(rpar_gt, SFT, &kp RPAR, &kp GT)

/ {
    combos {
        compatible = "zmk,combos";
        /* urob spots & tuning: esc LT3+LT2, bspc RT1+RT2, del RT2+RT3. */
        combo_esc {
            timeout-ms = <18>;
            key-positions = <2 3>; // W + F
            bindings = <&kp ESC>;
            layers = <0 1 2>;
            require-prior-idle-ms = <150>;
        };
        combo_bspc {
            timeout-ms = <18>;
            key-positions = <7 8>; // L + U
            bindings = <&kp BSPC>;
            layers = <0 1 2>;
            require-prior-idle-ms = <150>;
        };
        combo_del {
            timeout-ms = <18>;
            key-positions = <8 9>; // U + Y
            bindings = <&kp DEL>;
            layers = <0 1 2>;
            require-prior-idle-ms = <150>;
        };
        combo_tab {
            timeout-ms = <18>;
            key-positions = <14 15>; // R + S (urob LM3+LM2)
            bindings = <&kp TAB>;
            layers = <0 1 2>;
            require-prior-idle-ms = <150>;
        };
        /* Clipboard: cut/copy/paste on bottom row left (urob LB3+LB1 etc). */
        combo_cut {
            timeout-ms = <18>;
            key-positions = <26 28>; // X + D
            bindings = <&kp LC(X)>;
            layers = <0 1 2>;
            require-prior-idle-ms = <150>;
        };
        combo_copy {
            timeout-ms = <18>;
            key-positions = <26 27>; // X + C
            bindings = <&kp LC(INS)>;
            layers = <0 1 2>;
            require-prior-idle-ms = <150>;
        };
        combo_paste {
            timeout-ms = <18>;
            key-positions = <27 28>; // C + D
            bindings = <&kp LS(INS)>;
            layers = <0 1 2>;
            require-prior-idle-ms = <150>;
        };
        /* Brackets: [ ] on typing/number layers, { } on NAV (urob RB1+RB2 / RB2+RB3). */
        combo_lbkt {
            timeout-ms = <18>;
            key-positions = <31 32>; // H + comma
            bindings = <&kp LBKT>;
            layers = <0 1>;
            require-prior-idle-ms = <150>;
        };
        combo_rbkt {
            timeout-ms = <18>;
            key-positions = <32 33>; // comma + dot
            bindings = <&kp RBKT>;
            layers = <0 1>;
            require-prior-idle-ms = <150>;
        };
        combo_lbrc {
            timeout-ms = <18>;
            key-positions = <31 32>; // H + comma
            bindings = <&kp LBRC>;
            layers = <1>;
            require-prior-idle-ms = <150>;
        };
        combo_rbrc {
            timeout-ms = <18>;
            key-positions = <32 33>; // comma + dot
            bindings = <&kp RBRC>;
            layers = <1>;
            require-prior-idle-ms = <150>;
        };
        /* Parens: ( ) on BASE/NAV (urob RM1+RM2 / RM2+RM3). */
        combo_lpar {
            timeout-ms = <18>;
            key-positions = <19 20>; // N + E
            bindings = <&hm_combo_lpar RS(LCTRL) 0>;
            layers = <0 1>;
            require-prior-idle-ms = <150>;
        };
        combo_rpar {
            timeout-ms = <18>;
            key-positions = <20 21>; // E + I
            bindings = <&hm_combo_rpar RS(LALT) 0>;
            layers = <0 1>;
            require-prior-idle-ms = <150>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            /* urob base layer (QWF..B / JLUY..) on the inner 5 cols; outer cols stay toucan. */
            bindings = <
                &none &kp Q &kp W &kp F &kp P &kp B   &kp J &kp L &kp U &kp Y &kp SQT &none
                &none &hml LGUI A &hml LALT R &hml LCTRL S &hml LSHFT T &kp G   &kp M &hmr RSHFT N &hmr LCTRL E &hmr LALT I &hmr LGUI O &none
                &none &kp Z &kp X &kp C &kp D &kp V   &kp K &kp H &comma_morph &dot_morph &qexcl &none
                                   &kp LGUI &kp RET &lt NAV SPACE   &lt SYM BSPC &trans &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &none       &kp N1          &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &none
                &none       &bt BT_SEL 0    &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &none
                &none       &studio_unlock  &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &none
                                                &kp LGUI     &trans       &trans      &trans  &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &none &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &none
                &none &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &none
                &none &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &none
                                          &kp LGUI &trans   &trans   &trans   &trans    &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &none &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans &trans &none
                &none &trans &kp F4 &kp F5 &kp F6 &kp F11   &trans       &trans      &trans       &trans &trans &none
                &none &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans       &trans      &trans       &trans &trans &none
                                   &kp LGUI &trans &trans   &trans &trans &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
